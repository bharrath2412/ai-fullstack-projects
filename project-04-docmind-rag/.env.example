# DocMind configuration (copy to .env if your runner loads it)

DOCMIND_CORPUS=./corpus
DOCMIND_INDEX=./data/index

# Chunking
DOCMIND_CHUNK_CHARS=900
DOCMIND_CHUNK_OVERLAP=150
DOCMIND_MIN_CHUNK_CHARS=80

# Retrieval
DOCMIND_TOP_K=5
DOCMIND_DENSE_WEIGHT=0.55
DOCMIND_KEYWORD_WEIGHT=0.45
DOCMIND_MMR_LAMBDA=0.65
DOCMIND_MIN_SCORE=0.02

# Embeddings: hashing (offline) | openai
DOCMIND_EMBEDDING_PROVIDER=hashing
DOCMIND_EMBEDDING_DIM=384
DOCMIND_EMBEDDING_MODEL=text-embedding-3-small

# Generation: extractive (offline) | openai
DOCMIND_GENERATOR=extractive
DOCMIND_GENERATOR_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DOCMIND_MAX_QUESTION_CHARS=1000
DOCMIND_CORS=*
DOCMIND_LOG_LEVEL=info
