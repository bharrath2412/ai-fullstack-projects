# Copy to .env (or export) — all values are optional except LLM_API_KEY for the openai provider.

ENVIRONMENT=development

# mock = offline deterministic planner (no key, reproducible tests)
# openai = real function calling against any OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2

# Agent guardrails
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_STEP_TIMEOUT_SECONDS=20
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_TOOL_OUTPUT_CHARS=4000

# Tool sandboxing
SQLITE_PATH=./app/data/demo.db
SQL_MAX_ROWS=50
HTTP_ALLOWED_DOMAINS=example.com,api.github.com,wikipedia.org,en.wikipedia.org,httpbin.org
HTTP_TIMEOUT_SECONDS=8

CORS_ORIGINS=*
LOG_LEVEL=info
