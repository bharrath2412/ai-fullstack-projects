# Churn service configuration
CHURN_SEED=42
CHURN_N_SAMPLES=6000
CHURN_TEST_SIZE=0.2
CHURN_CV_FOLDS=5

# Leave blank to auto-tune the threshold on the validation split
CHURN_THRESHOLD=
CHURN_MIN_RECALL=0.70

# Drift bands (PSI)
CHURN_DRIFT_WARN=0.10
CHURN_DRIFT_ALERT=0.25

# Paths
CHURN_DATA_DIR=./data
CHURN_ARTIFACT_DIR=./artifacts
