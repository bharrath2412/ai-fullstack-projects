# AirGrid configuration — copy to .env.local and edit.
# Nothing here is required: with no env vars the app serves the committed snapshot.

# "bundled" (default) reads src/data/air-quality.json.
# "live" calls data.gov.in and falls back to the snapshot on any failure.
VITE_DATA_MODE=bundled

# Free key from https://data.gov.in (My Account → API key). Required only for live mode.
# Never commit a real key; VITE_* vars are inlined into the client bundle and are public.
VITE_DATA_GOV_KEY=

# Optional: point at a different data.gov.in resource id.
# VITE_DATA_GOV_RESOURCE=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
