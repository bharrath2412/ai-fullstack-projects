# Server configuration (copy to .env and adjust)
PORT=4000
NODE_ENV=development
DB_PATH=./data/taskflow.db

# REQUIRED in production — the app refuses to boot with the placeholder.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SEED_ON_START=false
LOG_REQUESTS=true
