# BillBook configuration. Copy to .env (or export) before running.
# Nothing secret is committed; every value below has a safe default.

# SQLite file. Relative paths resolve from the project directory.
BILLBOOK_DB=./billbook.db

# Sign JWTs. If unset, a random secret is generated per process (users are logged
# out on restart). Set a long random value anywhere real.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Token lifetime in seconds (default 8 hours).
TOKEN_TTL_SECONDS=28800

# dev | prod. "prod" refuses placeholder secrets.
ENV=dev

# Razorpay — TEST MODE ONLY. Live keys (rzp_live_…) are rejected at request time.
# Without these, payments run through the local simulator using the same HMAC scheme.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# auto (use Razorpay when keys exist) | simulated | razorpay
PAYMENT_MODE=auto

# Optional: load the demo shop on first start instead of running scripts/seed.py.
# DEMO_SEED=1
